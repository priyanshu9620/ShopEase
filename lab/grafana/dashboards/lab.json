      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#F2495C",
        "name": "lab events",
        "target": {
          "type": "tags",
          "tags": [
            "lab"
