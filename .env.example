# Copy to .env and fill in. `.env` is git-ignored — never commit it.

# --- app ---
PORT=8080
DEV_MODE=development
# docker compose: mongodb://mongo:27017   | bare laptop: mongodb://localhost:27017
MONGO_URL=mongodb://mongo:27017
JWT_SECRET=change-me-to-a-long-random-string

# --- Braintree sandbox (sandbox.braintreegateway.com → Settings → API → Keys) ---
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# --- seed (scripts/seed.js) ---
SEED_PRODUCTS=5000
SEED_ADMIN_PASSWORD=admin123
SEED_BUYER_PASSWORD=buyer123

# --- lab knobs (wired in Phase 2; harmless until then) ---
# REDIS_URL=redis://redis:6379
# CACHE_ENABLED=false
